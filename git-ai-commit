#!/usr/bin/env python3
"""
git-ai-commit: AI-powered Git commit generator and auto-sync tool using Google Gemini.

Generates concise, conventional commit messages from git diffs, stages changes,
commits them, and automatically pushes to your remote repository.
"""

import os
import sys
import re
import argparse
import subprocess
import tempfile
import urllib.request
from pathlib import Path
from typing import List, Optional, Tuple

import google.generativeai as genai
from dotenv import dotenv_values, load_dotenv
from rich.console import Console
from rich.panel import Panel
from rich.prompt import Confirm, Prompt

__version__ = "1.0.0"
__author__ = "mr-ceo7"

console = Console()

UPDATE_URL = "https://raw.githubusercontent.com/mr-ceo7/git-ai-commit/main/git-ai-commit"
CONFIG_DIR = Path.home() / ".config" / "git-ai-commit"
CONFIG_FILE = CONFIG_DIR / ".env"
LEGACY_CONFIG = Path("/usr/local/bin/.env")
DEFAULT_MODEL = "gemini-2.5-flash"
MAX_DIFF_CHARS = 24000


# ---------------------------------------------------------------------------
# Configuration Management
# ---------------------------------------------------------------------------

def get_config_file() -> Path:
    return CONFIG_FILE


def load_config() -> Tuple[Optional[str], str]:
    """
    Load GEMINI_API_KEY and GEMINI_MODEL with the following priority:
    1. os.environ
    2. ~/.config/git-ai-commit/.env
    3. Current working directory .env
    4. /usr/local/bin/.env (legacy fallback)
    """
    if CONFIG_FILE.is_file():
        load_dotenv(dotenv_path=CONFIG_FILE)

    cwd_env = Path.cwd() / ".env"
    if cwd_env.is_file():
        load_dotenv(dotenv_path=cwd_env)

    if "GEMINI_API_KEY" not in os.environ and LEGACY_CONFIG.is_file():
        load_dotenv(dotenv_path=LEGACY_CONFIG)

    api_key = os.getenv("GEMINI_API_KEY")
    model = os.getenv("GEMINI_MODEL", DEFAULT_MODEL)

    return api_key, model


def save_config(api_key: str, model: Optional[str] = None) -> Path:
    """Save API key and optional model to ~/.config/git-ai-commit/.env."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    current_model = model or DEFAULT_MODEL
    if CONFIG_FILE.is_file():
        existing = dotenv_values(CONFIG_FILE)
        if not model and "GEMINI_MODEL" in existing:
            current_model = existing["GEMINI_MODEL"]

    content = f"# git-ai-commit configuration\nGEMINI_API_KEY={api_key.strip()}\nGEMINI_MODEL={current_model.strip()}\n"
    CONFIG_FILE.write_text(content, encoding="utf-8")
    CONFIG_FILE.chmod(0o600)
    return CONFIG_FILE


# ---------------------------------------------------------------------------
# Git Operations
# ---------------------------------------------------------------------------

def run_git(args: List[str]) -> Tuple[int, str, str]:
    """Execute a git command and return (returncode, stdout, stderr)."""
    try:
        proc = subprocess.run(
            ["git"] + args,
            capture_output=True,
            text=True,
            check=False
        )
        return proc.returncode, proc.stdout, proc.stderr
    except FileNotFoundError:
        return 127, "", "git command not found in PATH"


def is_git_repository() -> bool:
    """Check if current directory is inside a git repository."""
    code, out, _ = run_git(["rev-parse", "--is-inside-work-tree"])
    return code == 0 and out.strip() == "true"


def get_current_branch() -> str:
    """Return current branch name."""
    code, out, _ = run_git(["branch", "--show-current"])
    if code == 0 and out.strip():
        return out.strip()
    code, out, _ = run_git(["rev-parse", "--abbrev-ref", "HEAD"])
    return out.strip() if code == 0 else "HEAD"


def has_remotes() -> bool:
    """Check if remote is configured."""
    code, out, _ = run_git(["remote"])
    return code == 0 and bool(out.strip())


def has_staged_changes() -> bool:
    """Check if there are already staged changes."""
    code, _, _ = run_git(["diff", "--staged", "--quiet"])
    return code != 0


def get_unstaged_files() -> List[str]:
    """Get list of unstaged or untracked files."""
    code, out, _ = run_git(["status", "--porcelain"])
    if code != 0 or not out.strip():
        return []

    unstaged_files = []
    for line in out.strip().split("\n"):
        if not line.strip():
            continue
        status = line[:2]
        filepath = line[3:].strip()
        if status[1] != " " or status == "??" or status[0] == "?":
            if " -> " in filepath:
                filepath = filepath.split(" -> ")[1].strip()
            unstaged_files.append(filepath)
    return unstaged_files


def stage_all() -> Tuple[bool, str]:
    """Stage all tracked and untracked changes."""
    code, out, err = run_git(["add", "-A"])
    return code == 0, err or out


def get_staged_diff() -> Optional[str]:
    """Get diff of staged files."""
    code, out, _ = run_git(["diff", "--staged"])
    return out if code == 0 else None


def commit_changes(message: str) -> Tuple[bool, str]:
    """Commit staged changes."""
    code, out, err = run_git(["commit", "-m", message])
    return code == 0, err or out


def push_changes() -> Tuple[bool, str]:
    """Push changes to remote."""
    code, out, err = run_git(["push"])
    return code == 0, err or out


# ---------------------------------------------------------------------------
# LLM Commit Message Generation
# ---------------------------------------------------------------------------

def clean_commit_message(raw_text: str) -> str:
    """Clean markdown fences or wrapping quotes from model response."""
    text = raw_text.strip()
    fence_pattern = r"^```(?:git|markdown|commit|text)?\n([\s\S]*?)\n```$"
    match = re.match(fence_pattern, text, re.IGNORECASE)
    if match:
        text = match.group(1).strip()
    elif text.startswith("```") and text.endswith("```"):
        lines = text.splitlines()
        if len(lines) >= 2:
            text = "\n".join(lines[1:-1]).strip()

    if (text.startswith('"') and text.endswith('"')) or (text.startswith("'") and text.endswith("'")):
        text = text[1:-1].strip()

    return text


def generate_commit_message(
    diff: str,
    api_key: str,
    model_name: str = DEFAULT_MODEL,
    hint: Optional[str] = None
) -> Tuple[Optional[str], Optional[str]]:
    """Generate conventional commit message from git diff using Gemini."""
    if not diff or not diff.strip():
        return None, "No staged changes detected to generate a commit message."

    try:
        genai.configure(api_key=api_key)
        target_model = model_name
        if not target_model.startswith("models/") and not target_model.startswith("gemini-"):
            target_model = f"models/{target_model}"

        model = genai.GenerativeModel(target_model)

        diff_payload = diff
        truncated_note = ""
        if len(diff) > MAX_DIFF_CHARS:
            diff_payload = diff[:MAX_DIFF_CHARS]
            truncated_note = f"\n[Note: Diff was truncated to first {MAX_DIFF_CHARS} characters for size]"

        hint_section = ""
        if hint and hint.strip():
            hint_section = f"\nUser hint / additional context:\n{hint.strip()}\n"

        prompt = f"""You are an expert Git commit message generator.
Analyze the git diff below and write a clear, accurate, and professional commit message following Conventional Commits format (e.g. feat:, fix:, refactor:, chore:, docs:, test:, style:, perf:).

Guidelines:
1. First line: Imperative mood, conventional commit prefix, concise summary (under 72 chars).
2. If the diff contains non-trivial changes, leave a blank line and list 2-4 concise bullet points explaining what was changed and why.
3. Do NOT wrap output in markdown code blocks, backticks, or quotes. Output ONLY the raw commit message text.
{hint_section}
Here is the git diff:{truncated_note}
{diff_payload}
"""

        response = model.generate_content(prompt)
        if not response or not response.text:
            return None, "Model returned an empty response."

        message = clean_commit_message(response.text)
        return message, None
    except Exception as exc:
        return None, str(exc)


# ---------------------------------------------------------------------------
# CLI Actions
# ---------------------------------------------------------------------------

def handle_config_command(args: argparse.Namespace) -> int:
    """Handle config subcommand."""
    if args.set_key:
        cfg_path = save_config(api_key=args.set_key, model=args.set_model)
        console.print(f"[bold green]✓ Gemini API key saved to:[/bold green] {cfg_path}")
        return 0

    if args.set_model:
        api_key, _ = load_config()
        if not api_key:
            console.print("[yellow]Warning: Setting model without existing API key.[/yellow]")
        cfg_path = save_config(api_key=api_key or "", model=args.set_model)
        console.print(f"[bold green]✓ Model set to:[/bold green] {args.set_model} ({cfg_path})")
        return 0

    if args.show:
        api_key, model = load_config()
        masked_key = f"{api_key[:6]}...{api_key[-4:]}" if api_key and len(api_key) > 10 else (api_key or "Not set")
        console.print(Panel(
            f"[bold]Config File:[/bold] {get_config_file()}\n"
            f"[bold]Gemini Model:[/bold] {model}\n"
            f"[bold]API Key:[/bold] {masked_key}",
            title="git-ai-commit Configuration",
            border_style="cyan"
        ))
        return 0

    console.print("Usage: git-ai-commit config --set-key <API_KEY> | --set-model <MODEL> | --show")
    return 1


def handle_update() -> int:
    """Self-update the standalone executable in ~/.local/bin or current script."""
    console.print("[cyan]Checking for updates from GitHub...[/cyan]")
    target_path = os.path.expanduser("~/.local/bin/git-ai-commit")
    
    try:
        req = urllib.request.Request(
            UPDATE_URL,
            headers={"User-Agent": f"git-ai-commit/{__version__}"}
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            content = resp.read()

        if not content:
            console.print("[red]Failed to fetch update: empty response.[/red]")
            return 1

        with tempfile.NamedTemporaryFile(delete=False) as tmp:
            tmp.write(content)
            tmp_path = tmp.name

        os.chmod(tmp_path, 0o755)
        os.replace(tmp_path, target_path)
        console.print(f"[bold green]✓ Successfully updated git-ai-commit at:[/bold green] {target_path}")
        return 0
    except Exception as exc:
        console.print(f"[red]Error during self-update: {exc}[/red]")
        return 1


def edit_message_in_editor(initial_text: str) -> str:
    """Open user's editor to edit commit message."""
    editor = os.getenv("VISUAL") or os.getenv("EDITOR") or ("nano" if os.name != "nt" else "notepad")
    with tempfile.NamedTemporaryFile(suffix=".txt", delete=False, mode="w+", encoding="utf-8") as tf:
        tf.write(initial_text)
        tf_path = tf.name

    try:
        subprocess.run([editor, tf_path], check=True)
        with open(tf_path, "r", encoding="utf-8") as f:
            edited = f.read().strip()
        return edited or initial_text
    except Exception as err:
        console.print(f"[yellow]Warning: Could not open editor ({err}). Keeping original message.[/yellow]")
        return initial_text
    finally:
        if os.path.exists(tf_path):
            os.remove(tf_path)


def run_commit_flow(args: argparse.Namespace) -> int:
    """Main workflow: stage, generate commit message, commit, and push."""
    api_key, default_model = load_config()
    if args.api_key:
        api_key = args.api_key
    model_name = args.model or default_model

    if not api_key:
        console.print("[bold red]Error: GEMINI_API_KEY is not configured.[/bold red]")
        console.print("Set your API key using one of:")
        console.print("  [cyan]git-ai-commit config --set-key YOUR_API_KEY[/cyan]")
        console.print("  [cyan]export GEMINI_API_KEY='YOUR_API_KEY'[/cyan]")
        console.print(f"  Or put it into [cyan]{get_config_file()}[/cyan]")
        return 1

    if not is_git_repository():
        console.print("[bold red]Error: Current directory is not a Git repository.[/bold red]")
        return 1

    # Staging
    if not args.no_stage:
        unstaged = get_unstaged_files()
        if unstaged:
            console.print(f"[cyan]Staging {len(unstaged)} modified/untracked file(s)...[/cyan]")
            ok, err = stage_all()
            if not ok:
                console.print(f"[bold red]Error staging files:[/bold red] {err}")
                return 1

    if not has_staged_changes():
        console.print("[yellow]Working tree clean: no staged changes to commit.[/yellow]")
        return 0

    diff = get_staged_diff()
    if not diff or not diff.strip():
        console.print("[yellow]No staged differences found.[/yellow]")
        return 0

    # Message Generation Loop
    while True:
        with console.status("[bold cyan]Generating commit message with Gemini...[/bold cyan]", spinner="dots"):
            message, err = generate_commit_message(
                diff=diff,
                api_key=api_key,
                model_name=model_name,
                hint=args.hint
            )

        if err or not message:
            console.print(f"[bold red]Error generating commit message:[/bold red] {err}")
            return 1

        console.print(Panel(
            f"[bold green]{message}[/bold green]",
            title=f"Generated Commit Message ({model_name})",
            border_style="green"
        ))

        if args.dry_run:
            console.print("[yellow]Dry-run mode: skipping commit and push.[/yellow]")
            return 0

        if args.interactive:
            choice = Prompt.ask(
                "Action",
                choices=["commit", "edit", "regenerate", "abort"],
                default="commit"
            )
            if choice == "abort":
                console.print("[yellow]Commit aborted by user.[/yellow]")
                return 0
            elif choice == "regenerate":
                console.print("[cyan]Regenerating...[/cyan]")
                continue
            elif choice == "edit":
                message = edit_message_in_editor(message)
                console.print(f"[bold green]Updated Message:[/bold green]\n{message}")
                break
            else:
                break
        else:
            break

    # Commit
    console.print("[cyan]Committing changes...[/cyan]")
    ok, err = commit_changes(message)
    if not ok:
        console.print(f"[bold red]Error committing changes:[/bold red]\n{err}")
        return 1

    console.print("[bold green]✓ Changes committed successfully![/bold green]")

    # Push
    should_push = not args.no_push
    if should_push and args.interactive:
        should_push = Confirm.ask("Push changes to remote repository?", default=True)

    if should_push:
        if not has_remotes():
            console.print("[yellow]No git remote configured. Skipping push.[/yellow]")
            return 0

        current_branch = get_current_branch()
        console.print(f"[cyan]Pushing changes to remote ({current_branch})...[/cyan]")
        ok, err = push_changes()
        if not ok:
            console.print(f"[bold red]Error pushing changes:[/bold red]\n{err}")
            return 1
        console.print("[bold green]✓ Changes pushed successfully![/bold green]")
    else:
        console.print("[dim]Skipping push (--no-push active).[/dim]")

    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="git-ai-commit",
        description="AI-powered Git commit generator and auto-sync tool using Google Gemini"
    )
    parser.add_argument(
        "-v", "--version",
        action="version",
        version=f"%(prog)s {__version__}"
    )
    parser.add_argument(
        "-m", "--hint",
        dest="hint",
        type=str,
        help="Provide a hint or context to guide the generated commit message"
    )
    parser.add_argument(
        "-i", "--interactive",
        action="store_true",
        help="Interactive mode: confirm/edit message and confirm push"
    )
    parser.add_argument(
        "-n", "--no-push",
        action="store_true",
        help="Commit changes but do not push to remote repository"
    )
    parser.add_argument(
        "--no-stage",
        action="store_true",
        help="Only commit changes that are already staged (do not auto-stage unstaged files)"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Generate commit message and display diff without committing or pushing"
    )
    parser.add_argument(
        "--model",
        type=str,
        help=f"Override Gemini model (default: {DEFAULT_MODEL})"
    )
    parser.add_argument(
        "--api-key",
        type=str,
        help="Override Gemini API key for this run"
    )
    parser.add_argument(
        "--update",
        action="store_true",
        help="Self-update git-ai-commit to the latest version from GitHub"
    )

    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    config_parser = subparsers.add_parser("config", help="Manage configuration and API key")
    config_parser.add_argument("--set-key", type=str, help="Save Gemini API key")
    config_parser.add_argument("--set-model", type=str, help="Save default Gemini model")
    config_parser.add_argument("--show", action="store_true", help="Display current configuration")

    subparsers.add_parser("update", help="Update git-ai-commit to latest release")

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if args.update or args.subcommand == "update":
        sys.exit(handle_update())

    if args.subcommand == "config":
        sys.exit(handle_config_command(args))

    sys.exit(run_commit_flow(args))


if __name__ == "__main__":
    main()
